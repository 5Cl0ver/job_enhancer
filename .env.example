# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase Dashboard -> Connect -> Connection string -> Transaction pooler
# (port 6543; swap the postgresql:// prefix for postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Auth (Supabase) ──────────────────────────────────────────────────────────
# Supabase Dashboard -> Settings -> API
# Google/GitHub OAuth credentials are configured INSIDE the Supabase dashboard
# (Authentication -> Providers), not here.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Frontend copies of the Supabase project values (safe to expose publicly)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── AI (final build phase) ───────────────────────────────────────────────────
# NVIDIA NIM API — get free key at build.nvidia.com/settings/api-keys
# Key always starts with nvapi-
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Job APIs ─────────────────────────────────────────────────────────────────
# Adzuna — register free at developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# JSearch via RapidAPI — subscribe free at rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_rapidapi_key_here

# ── API URL ──────────────────────────────────────────────────────────────────
# Backend URL accessible from the frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend Settings ─────────────────────────────────────────────────────────
DEBUG=true
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000
# Admin user email (granted admin role on first login)
ADMIN_EMAIL=your_email@example.com
