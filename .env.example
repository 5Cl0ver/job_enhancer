# ── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL — use the -pooler hostname for PgBouncer connection pooling
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/dbname

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# MUST be identical in both frontend and backend environments
AUTH_SECRET=your_32_byte_hex_secret_here

# NextAuth.js (frontend)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_32_byte_hex_secret_here  # same value as AUTH_SECRET

# OAuth providers (get from Google Cloud Console / GitHub OAuth Apps)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── AI ───────────────────────────────────────────────────────────────────────
# NVIDIA NIM API — get free key at build.nvidia.com/settings/api-keys
# Key always starts with nvapi-
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Job APIs ─────────────────────────────────────────────────────────────────
# Adzuna — register free at developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# JSearch via RapidAPI — subscribe free at rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_rapidapi_key_here

# ── API URL ──────────────────────────────────────────────────────────────────
# Backend URL accessible from the frontend (public)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend Settings ─────────────────────────────────────────────────────────
DEBUG=true
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000
# Admin user email (granted admin role on first login)
ADMIN_EMAIL=your_email@example.com
