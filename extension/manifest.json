{
  "manifest_version": 3,
  "name": "Job Enhancer — Job Catcher",
  "version": "0.13.0",
  "description": "Save jobs from any site to your Job Enhancer tracker — a side panel plus a one-click Save button on Indeed & LinkedIn job pages.",
  "permissions": ["sidePanel", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "dist/background.js" },
  "action": {
    "default_title": "Open Job Enhancer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://*.indeed.com/*", "https://*.linkedin.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.indeed.com/*"],
      "js": ["dist/bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*"],
      "js": ["dist/autofill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
